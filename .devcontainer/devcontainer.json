{
    "name": "Mistério no Expresso do Oriente - SQL",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    
    // Instala o PostgreSQL automaticamente como uma Feature do Dev Container
    "features": {
        "ghcr.io/devcontainers/features/postgres:1": {
            "version": "16"
        }
    },

    // Executa comandos automaticamente logo após o container ser criado e iniciado
    "postCreateCommand": "sudo service postgresql start && psql -U postgres -f schema.sql && psql -U postgres -f data.sql",

    // Configurações do VS Code dentro do Codespace
    "customizations": {
        "vscode": {
            "extensions": [
                "mtxr.sqltools", // Extensão excelente para gerenciar bancos graficamente, se quiserem
                "mtxr.sqltools-driver-pg"
            ]
        }
    },

    // Garante que o container rode com o usuário correto para não dar erro de permissão no psql
    "remoteUser": "vscode"
}