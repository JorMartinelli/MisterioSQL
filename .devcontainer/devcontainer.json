{
    "name": "Misterio no Expresso do Oriente",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
    
    // Injeta o PostgreSQL limpo e configura os caminhos automaticamente
    "features": {
        "ghcr.io/devcontainers/features/postgres:1": {
            "version": "15"
        }
    },
    
    // Executa nosso script de inicialização assim que o container estiver pronto
    "postStartCommand": "bash .devcontainer/post-start.sh",

    "customizations": {
        "vscode": {
            "extensions": [
                "mtxr.sqltools",
                "mtxr.sqltools-driver-pg",
                "ckearnell.mrdark"
            ]
        }
    },

    "remoteUser": "vscode"
}