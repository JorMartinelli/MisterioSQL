{
    "name": "Mistério no Expresso do Oriente",
    "image": "mcr.microsoft.com/devcontainers/universal:2",
    
    // Executa nosso script de inicialização assim que o container subir
    "postStartCommand": "bash .devcontainer/post-start.sh",

    // Configurações úteis para o VS Code dentro do Codespace
    "customizations": {
        "vscode": {
            "extensions": [
                "mtxr.sqltools",
                "mtxr.sqltools-driver-pg",
                "ckearnell.mrdark"
            ]
        }
    },

    "remoteUser": "codespace"
}