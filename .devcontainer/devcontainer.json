{
    "name": "Misterio SQL - Expresso do Oriente",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "features": {
        "ghcr.io/devcontainers/features/postgres:1": {
            "version": "16"
        }
    },
    "postCreateCommand": "sudo /etc/init.d/postgresql start && sleep 5 && psql -U postgres -f schema.sql && psql -U postgres -f data.sql",
    "customizations": {
        "vscode": {
            "extensions": [
                "mtxr.sqltools",
                "mtxr.sqltools-driver-pg"
            ]
        }
    },
    "remoteUser": "vscode"
}