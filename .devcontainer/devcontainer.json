{
    "name": "Misterio no Expresso do Oriente",
    "build": {
        "dockerfile": "Dockerfile"
    },
    
    // Roda nosso script para estruturar o banco de dados
    "postStartCommand": "bash .devcontainer/post-start.sh",

    "customizations": {
        "vscode": {
            "extensions": [
                "mtxr.sqltools",
                "mtxr.sqltools-driver-pg",
                "ckearnell.mrdark"
            ]
        }
    },

    "remoteUser": "vscode"
}